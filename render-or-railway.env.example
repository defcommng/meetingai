AI_API_KEY=replace-with-a-long-random-secret

WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=3
WHISPER_VAD_FILTER=true

SUMMARY_ENABLED=true
SUMMARY_MODEL=google/flan-t5-small
SUMMARY_MAX_INPUT_TOKENS=1800
SUMMARY_MAX_NEW_TOKENS=256
SUMMARY_NUM_BEAMS=2
SUMMARY_CHUNK_CHARS=6000

DATA_DIR=/var/data
WHISPER_MODEL_CACHE=/var/data/models
SUMMARY_MODEL_CACHE=/var/data/models
HF_HOME=/var/data/huggingface
HF_HUB_CACHE=/var/data/huggingface/hub

WORKER_POLL_SECONDS=2
WORKER_STALE_SECONDS=21600
UNLOAD_WHISPER_BEFORE_SUMMARY=true
UNLOAD_SUMMARY_AFTER_JOB=false
MODEL_WARMUP=false
MAX_UPLOAD_BYTES=2147483648
