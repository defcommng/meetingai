WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=3
WHISPER_VAD_FILTER=true
DATA_DIR=/tmp/defcomm-ai
HF_HOME=/tmp/huggingface
HF_HUB_CACHE=/tmp/huggingface/hub
AI_API_KEY=replace-with-a-long-random-secret

# OpenAI-compatible summary provider (the SFU calls /v1/meeting/summarize)
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=120
